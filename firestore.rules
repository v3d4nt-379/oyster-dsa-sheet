rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Topics Collection
    // Read: authenticated users only
    // Write: admin only
    match /topics/{topicId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Questions Collection
    // Read: authenticated users only
    // Write: admin only
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // User Specific Data (Phase 5 + 8)
    match /users/{userId} {
      // Normal user can read their own, Admin can read all
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Admin can update anything. Normal user can update anything except isClubMember
      allow update: if request.auth != null && (
        request.auth.token.admin == true ||
        (request.auth.uid == userId && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isClubMember'])))
      );
      allow delete: if false;

      // Marathon Progress
      match /solved/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /bookmarks/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // OKC Progress
      match /okcSolved/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubMember == true || request.auth.token.admin == true
        );
      }
      
      match /okcBookmarks/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubMember == true || request.auth.token.admin == true
        );
      }
    }

    // OKC Collection
    match /okcQuestions/{questionId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubMember == true || request.auth.token.admin == true
      );
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // OKC Topics Collection
    match /okcTopics/{topicId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubMember == true || request.auth.token.admin == true
      );
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Daily Sets Collection
    match /dailySets/{setId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isClubMember == true || request.auth.token.admin == true
      );
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
